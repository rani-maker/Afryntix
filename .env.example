# ==========================================
# AFRYNTIX - Variables d'environnement
# ==========================================

# Database (Supabase PostgreSQL)
# Connexion poolée via PgBouncer — pour l'app en runtime (port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Connexion directe — pour prisma db push / migrate (port 5432)
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# WhatsApp — Twilio (WhatsApp Business API, officiel Meta)
# Console Twilio → Account → API keys & tokens
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token_here"
# En sandbox : whatsapp:+14155238886 ou numéro sandbox affecté à ton compte
# En prod : ton numéro dédié validé Meta (whatsapp:+225...)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optionnel — Messaging Service SID (recommandé prod pour scalabilité et failover)
# TWILIO_MESSAGING_SERVICE_SID="MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Templates WhatsApp approuvés par Meta (ContentSid Twilio, format HX...)
# Un SID vide ou absent → l'appel bascule automatiquement sur le body freeform.
TWILIO_TEMPLATE_RECEPTION_NOTICE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TEMPLATE_SHIPMENT_AVAILABLE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TEMPLATE_SHIPMENTS_AVAILABLE_MULTI_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TEMPLATE_PICKUP_CODE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_TEMPLATE_RESERVATION_VALIDATED_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# OTP vérification compte / reset password (catégorie AUTHENTICATION)
TWILIO_TEMPLATE_VERIFICATION_CODE_SID="HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optionnels (créer les templates Meta correspondants d'abord) :
# TWILIO_TEMPLATE_SHIPMENT_STATUS_UPDATE_SID=""
# TWILIO_TEMPLATE_WITHDRAWAL_CODE_SID=""
# TWILIO_TEMPLATE_PARTNER_COMMISSION_SID=""
# TWILIO_TEMPLATE_PARTNER_PAYOUT_SID=""
# TWILIO_TEMPLATE_PARTNER_WELCOME_SID=""

# Admin par défaut (pour le seed)
DEFAULT_ADMIN_EMAIL="admin@afryntix.com"
DEFAULT_ADMIN_PASSWORD="ChangeMeNow!2026"
DEFAULT_ADMIN_NAME="Administrateur AFRYNTIX"
DEFAULT_ADMIN_PHONE="+2250700000000"

# Upload (local par défaut, S3 optionnel)
UPLOAD_DIR="./public/uploads"

# Supabase Storage — pour uploads KYC partenaires (pièce d'identité, contrats signés)
# Récupérer dans Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."           # clé publique (anon)
SUPABASE_SERVICE_ROLE_KEY="ey..."               # clé SECRÈTE service_role (jamais exposer côté client)
# Créer le bucket "partner-kyc" en mode PRIVÉ dans Storage avant utilisation

# App
NEXT_PUBLIC_APP_NAME="AFRYNTIX"
NEXT_PUBLIC_COMPANY_TAGLINE="Transport & Logistique Chine - Afrique de l'Ouest"
# URL publique utilisée pour les QR codes d'étiquettes, les liens WhatsApp (suivi, retrait)
# et les invitations staff. EN PROD : remplacer par le domaine définitif (sans slash final).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Emails ---
# Envoi par la boîte de l'entreprise (Namecheap Private Email). Prioritaire sur Resend.
# NB : l'offre gratuite de Render bloque les ports SMTP (offre payante requise).
SMTP_HOST="mail.privateemail.com"
SMTP_PORT="465"
SMTP_USER="infos@afryntix.com"
SMTP_PASSWORD=""
# Expéditeur : en SMTP, doit être la boîte SMTP_USER
EMAIL_FROM="AFRYNTIX <infos@afryntix.com>"
# Boîte qui reçoit les bons de commande catalogue et la copie des devis
ORDERS_NOTIFY_EMAIL="infos@afryntix.com"
# Alternative sans SMTP : clé API Resend (https://resend.com), domaine vérifié requis
RESEND_API_KEY=""
